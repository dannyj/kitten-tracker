# ─────────────────────────────────────────────────────────────────────────────
# Kitten Foster Tracker — environment configuration
#
# Copy this file to `.env` at the repo root, then fill in the values below.
#   cp templates/.env.example .env
# `.env` is git-ignored. NEVER commit real secrets.
#
# NODE_ENV and NEXT_RUNTIME are set by the framework — do not set them here.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — HMAC key for session tokens.
# Must be at least 32 characters or the app refuses to start a session.
# Keep it STABLE across restarts/environments: changing it logs everyone out.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-me-with-64-hex-chars-from-openssl-rand-hex-32

# OPTIONAL — Path to the SQLite database file (created + migrated on first boot).
# Local dev default: ./data/kittens.db   |   Docker: /data/kittens.db (volume)
DATABASE_PATH=./data/kittens.db

# OPTIONAL — Directory for uploaded (re-encoded WebP) photos.
# Local dev default: ./data/photos       |   Docker: /photos (volume)
PHOTOS_PATH=./data/photos
