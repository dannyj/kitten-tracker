# Copy to .env and fill in. Never commit .env.

# 64+ random hex chars. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Absolute path to the SQLite database file.
# Local dev: ./data/kittens.db — Docker: /data/kittens.db (volume)
DATABASE_PATH=./data/kittens.db

# Directory for uploaded photos.
# Local dev: ./data/photos — Docker: /photos (volume)
PHOTOS_PATH=./data/photos
